                "    #\"Valor Substituído1\" = Table.ReplaceValue(#\"Valor Substituído\",\"Wikipedia\",\"\",Replacer.ReplaceText,{\"Wikipedia\"}),",
                "    #\"Valor Substituído2\" = Table.ReplaceValue(#\"Valor Substituído1\",\"País\",\"\",Replacer.ReplaceText,{\"País\"}),",
                "    #\"Linhas em Branco Removidas\" = Table.SelectRows(#\"Valor Substituído2\", each not List.IsEmpty(List.RemoveMatchingItems(Record.FieldValues(_), {\"\", null}))),",
                "    #\"Personalização Adicionada1\" = Table.AddColumn(#\"Linhas em Branco Removidas\", \"Localização\", each [País] & \";\" & [Cidade]),",
                "    #\"Colunas Reordenadas\" = Table.ReorderColumns(#\"Personalização Adicionada1\",{\"País\", \"Cidade\", \"Localização\", \"Wikipedia\"}),",
                "    #\"Valor Substituído3\" = Table.ReplaceValue(#\"Colunas Reordenadas\",\" do México\",\"do México\",Replacer.ReplaceText,{\"Cidade\"}),",
                "    #\"Valor Substituído4\" = Table.ReplaceValue(#\"Valor Substituído3\",\"do México\",\"Cidade do México\",Replacer.ReplaceText,{\"Cidade\"}),",
                "    #\"Personalização Adicionada2\" = Table.AddColumn(#\"Valor Substituído4\", \"Localização1\", each [País] & \";\" & [Cidade]),",
                "    #\"Colunas Reordenadas1\" = Table.ReorderColumns(#\"Personalização Adicionada2\",{\"País\", \"Cidade\", \"Localização1\", \"Localização\", \"Wikipedia\"}),",
                "    #\"Colunas Removidas1\" = Table.RemoveColumns(#\"Colunas Reordenadas1\",{\"Localização\"}),",
                "    #\"Colunas Renomeadas1\" = Table.RenameColumns(#\"Colunas Removidas1\",{{\"Localização1\", \"Localização\"}})",
                "in",
                "    #\"Colunas Renomeadas1\""
              ],
              "type": "m"
            }
          }
        ]
      },
