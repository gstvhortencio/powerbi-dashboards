            "name": "dim_Produto",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Fonte = Excel.Workbook(File.Contents(\"C:\\Users\\gustavo.hortencio\\Downloads\\A6 - Pratique\\dados_exercicio_entrega\\Produto.xlsx\"), null, true),",
                "    Produto_Sheet = Fonte{[Item=\"Produto\",Kind=\"Sheet\"]}[Data],",
                "    #\"Cabeçalhos Promovidos\" = Table.PromoteHeaders(Produto_Sheet, [PromoteAllScalars=true]),",
                "    #\"Tipo Alterado\" = Table.TransformColumnTypes(#\"Cabeçalhos Promovidos\",{{\"ProdutoID\", type text}, {\"SubcategoriaID\", Int64.Type}, {\"Cor\", type text}, {\"NomeProduto\", type text}, {\"PrecoVarejo\", Int64.Type}, {\"CustoPadrao\", Int64.Type}}),",
                "    #\"Personalização Adicionada\" = Table.AddColumn(#\"Tipo Alterado\", \"ProdutoID_Num\", each Text.Select([ProdutoID], {\"0\"..\"9\"})),",
                "    #\"Colunas Reordenadas\" = Table.ReorderColumns(#\"Personalização Adicionada\",{\"ProdutoID\", \"ProdutoID_Num\", \"SubcategoriaID\", \"Cor\", \"NomeProduto\", \"PrecoVarejo\", \"CustoPadrao\"}),",
                "    #\"Tipo Alterado1\" = Table.TransformColumnTypes(#\"Colunas Reordenadas\",{{\"ProdutoID_Num\", Int64.Type}}),",
                "    #\"Colunas Removidas\" = Table.RemoveColumns(#\"Tipo Alterado1\",{\"ProdutoID\"}),",
                "    #\"Colunas Renomeadas\" = Table.RenameColumns(#\"Colunas Removidas\",{{\"ProdutoID_Num\", \"ProdutoID\"}}),",
                "    #\"Tipo Alterado2\" = Table.TransformColumnTypes(#\"Colunas Renomeadas\",{{\"PrecoVarejo\", type number}}),",
                "    #\"Valor Substituído\" = Table.ReplaceValue(#\"Tipo Alterado2\",2395,23.95,Replacer.ReplaceValue,{\"PrecoVarejo\"}),",
                "    #\"Valor Substituído1\" = Table.ReplaceValue(#\"Valor Substituído\",4395,43.95,Replacer.ReplaceValue,{\"PrecoVarejo\"}),",
                "    #\"Valor Substituído2\" = Table.ReplaceValue(#\"Valor Substituído1\",2695,26.95,Replacer.ReplaceValue,{\"PrecoVarejo\"}),",
                "    #\"Valor Substituído3\" = Table.ReplaceValue(#\"Valor Substituído2\",2995,29.95,Replacer.ReplaceValue,{\"PrecoVarejo\"}),",
                "    #\"Valor Substituído4\" = Table.ReplaceValue(#\"Valor Substituído3\",755,7.55,Replacer.ReplaceValue,{\"CustoPadrao\"}),",
                "    #\"Valor Substituído5\" = Table.ReplaceValue(#\"Valor Substituído4\",1375,13.75,Replacer.ReplaceValue,{\"CustoPadrao\"}),",
                "    #\"Valor Substituído6\" = Table.ReplaceValue(#\"Valor Substituído5\",825,8.25,Replacer.ReplaceValue,{\"CustoPadrao\"}),",
