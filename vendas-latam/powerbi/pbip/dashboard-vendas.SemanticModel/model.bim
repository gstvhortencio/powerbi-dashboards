            "formatString": "Long Date",
            "lineageTag": "2834064f-ae60-4456-8d47-784e6ec8c35b",
            "sourceColumn": "Data",
            "summarizeBy": "none"
          },
          {
            "name": "Unidades",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "lineageTag": "e9cf7c7c-2400-4892-8774-05b8b20621e3",
            "sourceColumn": "Unidades",
            "summarizeBy": "none"
          },
          {
            "name": "PercentualDoCustoPadrão",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "decimal",
            "formatString": "0",
            "lineageTag": "2529de2e-d178-404c-952a-b1bed8e41d96",
            "sourceColumn": "PercentualDoCustoPadrão",
            "summarizeBy": "sum"
          },
          {
            "name": "DescontoDeReceita",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "decimal",
            "formatString": "0",
            "lineageTag": "9832c199-acc0-42e8-96e8-1e15a9c1a8b8",
            "sourceColumn": "DescontoDeReceita",
            "summarizeBy": "sum"
          }
        ],
        "lineageTag": "6439963e-d7ff-4abc-938c-1d7ed480381e",
        "measures": [
          {
            "name": "Receita Total",
            "expression": "SUMX(fact_Vendas, fact_Vendas[Unidades] * RELATED(dim_Produto[PrecoVarejo]) * (1 - fact_Vendas[DescontoDeReceita]))",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "175ec913-4ddb-49f8-98c2-c3251d7329a6"
          },
          {
            "name": "Custo Total",
            "expression": "SUMX(fact_Vendas, fact_Vendas[Unidades] * RELATED(dim_Produto[CustoPadrao]) * fact_Vendas[PercentualDoCustoPadrão])",
            "formatString": "0.00",
            "lineageTag": "d8b043e7-e722-45d9-9ae8-98e171548da7"
          },
          {
            "name": "Lucro Bruto",
            "expression": "[Receita Total] - [Custo Total]",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "88af1870-232e-472a-af0c-31f23d4d8ef7"
          },
          {
            "name": "Margem Bruta",
            "expression": "DIVIDE([Lucro Bruto], [Receita Total], 0)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "6b6d77aa-b4b7-4b22-a0a8-caca42e1685e"
          },
          {
            "name": "Market Share % (por país)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "DIVIDE([Receita Total], CALCULATE([Receita Total], ALL(dim_Geografia)), 0)",
            "lineageTag": "328b903e-023a-4989-9ca0-95468af4b94d"
          },
          {
            "name": "Receita YTD",
            "expression": "TOTALYTD([Receita Total], dim_Calendario[Data])",
            "formatString": "0.00",
            "lineageTag": "b8b247e3-5ae4-46f8-af3b-eb9d080b3139"
          },
          {
            "name": "Receita YTD LY",
            "expression": "CALCULATE([Receita YTD], SAMEPERIODLASTYEAR(dim_Calendario[Data]))",
            "formatString": "0.00",
            "lineageTag": "cebfa3a7-13d2-42e2-a8ff-ff8b7d13a78a"
          },
          {
            "name": "Receita MTD",
            "expression": "TOTALMTD([Receita Total], dim_Calendario[Data])",
            "formatString": "0.00",
            "lineageTag": "5c6acda2-37f0-4cb8-9bd4-19204a6ff6ce"
          },
          {
            "name": "Receita MAT (últimos 12 meses)",
            "expression": "CALCULATE([Receita Total], DATESINPERIOD(dim_Calendario[Data], MAX(dim_Calendario[Data]), -12, MONTH))",
            "formatString": "0.00",
            "lineageTag": "35ba4ac5-23ba-4639-8cf8-666d9644b6f3"
          },
          {
            "name": "Ranking de Vendedores",
            "expression": "RANKX(ALL(dim_Representante[NomeRepresentante]), [Receita Total])",
            "formatString": "0",
            "lineageTag": "c5547e48-1a89-44d4-ac5b-945064e2c0b1"
          }
        ],
        "partitions": [
          {
            "name": "fact_Vendas",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Fonte = Excel.Workbook(File.Contents(\"C:\\Users\\gustavo.hortencio\\Downloads\\A6 - Pratique\\dados_exercicio_entrega\\Vendas.xlsx\"), null, true),",
                "    Vendas_Sheet = Fonte{[Item=\"Vendas\",Kind=\"Sheet\"]}[Data],",
                "    #\"Cabeçalhos Promovidos\" = Table.PromoteHeaders(Vendas_Sheet, [PromoteAllScalars=true]),",
                "    #\"Personalização Adicionada\" = Table.AddColumn(#\"Cabeçalhos Promovidos\", \"Data\", each #date([Ano], [Mês], [Dia])),",
                "    #\"Colunas Reordenadas\" = Table.ReorderColumns(#\"Personalização Adicionada\",{\"ChavePrimariaVendas\", \"ProdutoID\", \"RepresentanteID\", \"Localização\", \"Data\", \"Dia\", \"Mês\", \"Ano\", \"Unidades\", \"PercentualDoCustoPadrão\", \"DescontoDeReceita\"}),",
                "    #\"Tipo Alterado1\" = Table.TransformColumnTypes(#\"Colunas Reordenadas\",{{\"Data\", type date}}),",
                "    #\"Colunas Removidas\" = Table.RemoveColumns(#\"Tipo Alterado1\",{\"Dia\", \"Mês\", \"Ano\"}),",
                "    #\"Tipo Alterado com Localidade\" = Table.TransformColumnTypes(#\"Colunas Removidas\", {{\"PercentualDoCustoPadrão\", Currency.Type}, {\"DescontoDeReceita\", Currency.Type}}, \"en-US\")",
                "in",
                "    #\"Tipo Alterado com Localidade\""
              ],
              "type": "m"
            }
          }
        ]
      },
